# Copy to .env locally. Never commit your keys.
PHARMA_PROVIDER=gemini
PHARMA_MODEL=
GEMINI_API_KEY=
PHARMA_SEARCH_PROVIDER=brave
BRAVE_API_KEY=
# No search account or card: install .[search] and set PHARMA_SEARCH_PROVIDER=duckduckgo
# Optional: sends investigation traces and evidence context to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pharma-scope
